// Діаграма станів передавача spi_tx (стан = active + bitn; рендер: dot -Tpng)
digraph spi_tx_fsm {
    graph [rankdir=LR, fontname="DejaVu Sans", fontsize=11, nodesep=0.6, ranksep=0.85, pad=0.25, bgcolor="white"];
    node  [shape=circle, style=filled, fontname="DejaVu Sans", fontsize=11, width=1.15, fixedsize=true, penwidth=1.6];
    edge  [fontname="DejaVu Sans", fontsize=9, color="#3b6fb6", fontcolor="#1f3b63", penwidth=1.3, arrowsize=0.8];

    IDLE [label=<<b>IDLE</b><br/><font point-size="8">active=0<br/>MOSI=0</font>>, fillcolor="#e8eef7", color="#3b6fb6"];
    B0   [label=<<b>BIT 0</b><br/><font point-size="8">MOSI = D7 (MSB)<br/>bitn=0</font>>, fillcolor="#fdf3d0", color="#b08a1e"];
    BN   [label=<<b>BIT n</b><br/><font point-size="8">MOSI = D(7−n)<br/>n = 1..6</font>>, fillcolor="#fdf3d0", color="#b08a1e"];
    B7   [label=<<b>BIT 7</b><br/><font point-size="8">MOSI = D0 (LSB)<br/>bitn=7</font>>, fillcolor="#fdf3d0", color="#b08a1e"];

    start [shape=point, width=0.12, color="#555555"];
    start -> IDLE [label="rst_n=0", color="#555555", fontcolor="#555555"];

    IDLE -> B0 [label="load: shreg ← tx_data\ntx_req"];
    B0 -> BN   [label="shift: shreg ≪ 1"];
    BN -> BN   [label="shift (n<6)"];
    BN -> B7   [label="shift (n=6)"];
    B7 -> B0   [label="load: наступний байт\n(cmd_len > 1), tx_req"];
    B7 -> IDLE [label="clear (кінець транзакції)", color="#c62828", fontcolor="#c62828"];
    note [shape=note, style=filled, fillcolor="#f5f5f5", color="#999999", fixedsize=false, width=0, fontsize=9,
          label="Моменти load / shift задає ядро:\lCPHA = 0: load у стані LEAD, shift на задньому фронті SCLK\lCPHA = 1: load і shift на передньому фронті SCLK\l"];
    { rank=same; IDLE; note; }
    note -> IDLE [style=invis];
}
