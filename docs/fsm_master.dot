// Діаграма станів головного автомата spi_master (рендер: dot -Tpng)
digraph spi_master_fsm {
    graph [rankdir=TB, fontname="DejaVu Sans", fontsize=11, nodesep=1.4, ranksep=1.1, pad=0.3, bgcolor="white", newrank=true];
    node  [shape=circle, style=filled, fontname="DejaVu Sans", fontsize=11, width=1.25, fixedsize=true, penwidth=1.6];
    edge  [fontname="DejaVu Sans", fontsize=9, color="#3b6fb6", fontcolor="#1f3b63", penwidth=1.3, arrowsize=0.8];

    IDLE [pos="0,2.6!", label=<<b>IDLE</b><br/><font point-size="8">SS_n=1, SCLK=CPOL<br/>busy=0</font>>, fillcolor="#e8eef7", color="#3b6fb6"];
    LEAD [pos="3.3,2.6!", label=<<b>LEAD</b><br/><font point-size="8">SS_n=1, SCLK=CPOL<br/>чекає T/2</font>>, fillcolor="#fdf3d0", color="#b08a1e"];
    XFER [pos="6.6,2.6!", label=<<b>XFER</b><br/><font point-size="8">фронт кожні<br/>HALF тактів</font>>, fillcolor="#fdf3d0", color="#b08a1e"];
    LAG  [pos="6.6,0!", label=<<b>LAG</b><br/><font point-size="8">SS_n=0, SCLK=CPOL<br/>t_lag = T/2</font>>, fillcolor="#fdf3d0", color="#b08a1e"];
    GAP  [pos="3.3,0!", label=<<b>GAP</b><br/><font point-size="8">SS_n=1<br/>t_idle ≥ T/2</font>>, fillcolor="#e8eef7", color="#3b6fb6"];

    start [shape=point, width=0.12, color="#555555", pos="-1.3,2.6!"];
    { rank=same; start; IDLE; LEAD; XFER; }
    { rank=same; GAP; LAG; }
    GAP -> LAG [style=invis];
    start -> IDLE [xlabel="rst_n=0", color="#555555", fontcolor="#555555"];

    IDLE -> IDLE [xlabel="cmd_start=0", tailport=n, headport=nw];
    IDLE -> LEAD [label="cmd_start: SCLK ← CPOL,\nфіксуються CPOL, CPHA,\nleft = cmd_len−1"];
    LEAD -> XFER [label="hcnt = HALF−1: SS_n ← 0\n(CPHA=0: MSB на MOSI)"];
    XFER -> XFER [label="hcnt = HALF−1: SCLK ← ~SCLK,\necnt++; ecnt=15 і left>0:\nleft−− (наступний байт)"];
    XFER -> LAG  [label="ecnt = 15 і left = 0\n(16-й фронт останнього байта)"];
    LAG  -> GAP  [label="hcnt = HALF−1\nSS_n ← 1, MOSI ← 0"];
    GAP  -> IDLE [label="hcnt = HALF−1\ndone ← 1"];
}
